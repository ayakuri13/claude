# === xAI (Grok) API ===
# https://x.ai/ からサインアップしてAPIキーを取得
# 従量課金（1回の呼び出し約 $0.1）
XAI_API_KEY=your_xai_api_key_here

# （任意）モデルやベースURLの変更
# XAI_BASE_URL=https://api.x.ai
# XAI_MODEL=grok-3-fast

# === マルチデバイス同期（任意）===
# 複数の環境（PC・サーバーなど）で重複通知を防ぐには、
# DropboxやiCloudなどのクラウド同期フォルダ内のパスを指定する
# 未設定の場合は data/notified.json（ローカル）を使用
# STORE_PATH=/path/to/Dropbox/trending-notifier/notified.json

# === LINE Messaging API（任意）===
# LINE Developers コンソールから取得
# https://developers.line.biz/console/
# 未設定の場合はコンソール出力のみ
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
